{
  "name": "tutoring-management-system",
  "version": "1.0.0",
  "description": "Integrated Tutor Mx React, Auth0, Express, Prisma and Neon project",
  "main": "dist/server.js",
  "scripts": {
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "vitest run",
    "test:frontend": "npm run test --prefix frontend",
    "test:schema": "vitest run src/database-schema.test.ts",
    "generate": "prisma generate",
    "dev": "node scripts/dev.mjs",
    "dev:backend": "tsx watch src/server.ts",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "tsc -p tsconfig.build.json",
    "build:frontend": "npm run build --prefix frontend",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "lint:backend": "eslint \"src/**/*.ts\"",
    "lint:frontend": "npm run lint --prefix frontend",
    "test:watch": "vitest",
    "coverage": "npm run coverage:backend && npm run coverage:frontend",
    "coverage:backend": "vitest run --coverage",
    "coverage:frontend": "npm run test:coverage --prefix frontend",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force && prisma db seed",
    "db:verify": "tsx scripts/verify-database.ts",
    "spike:holidays": "tsx scripts/spike-public-holidays.ts",
    "smoke": "tsx scripts/smoke-health.ts",
    "security:smoke": "tsx scripts/security-smoke.ts",
    "security:check": "node scripts/check-repository.mjs",
    "check": "npm run generate && npm run lint && npm run typecheck && npm test && npm run build && npm run security:check"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.3",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
