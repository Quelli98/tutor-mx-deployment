# Local development only. Copy to .env and replace every placeholder.
DATABASE_URL=postgresql://tutor_mx:tutor_mx@127.0.0.1:5432/tutor_mx
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173

# Auth0 API settings. These identifiers are configuration, not Management API secrets.
AUTH0_DOMAIN=your-tenant-region.auth0.com
AUTH0_AUDIENCE=https://api.tutormx.example
AUTH0_CLIENT_ID=your-spa-client-id
AUTH0_DB_CONNECTION=Username-Password-Authentication
AUTH0_ROLES_CLAIM=https://tutormx.example/roles

# Server-only Auth0 Management API M2M client. Grant read:users, read:roles, update:users; keep delete:users if account deletion is enabled.
AUTH0_MANAGEMENT_CLIENT_ID=your-management-client-id
AUTH0_MANAGEMENT_CLIENT_SECRET=your-management-client-secret

# SECURITY: false is safer. Set true only if anyone may self-register as an organiser in this environment.
ALLOW_SELF_SERVICE_ORGANISER=false

# Used only by the deployment smoke command. Do not put credentials in this URL.
SMOKE_BASE_URL=https://api.example.invalid
