# Copy this file to .env.local and fill in the real values.
# Never commit .env.local — it is already in .gitignore.

# Auth0 tenant domain (found in Auth0 Dashboard → Application Settings)
VITE_AUTH0_DOMAIN=your-tenant-region.auth0.com

# Auth0 SPA Client ID (found in Auth0 Dashboard → Application Settings)
VITE_AUTH0_CLIENT_ID=your-spa-client-id

# Auth0 API audience identifier (found in Auth0 Dashboard → APIs)
VITE_AUTH0_AUDIENCE=https://api.tutormx.example

# Backend API base URL (Express server)
VITE_API_BASE_URL=http://localhost:3000
