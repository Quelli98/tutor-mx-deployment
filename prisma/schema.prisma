generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ORGANISER
  TUTOR
  STUDENT
}

enum TimeSlotType {
  AVAILABLE
  BUSY
}

enum AllocationStatus {
  PROPOSED
  CONFIRMED
  CANCELLED
}

model Profile {
  id          Int             @id @default(autoincrement())
  auth0Id     String          @unique
  email       String          @unique
  fullName    String
  role        UserRole
  tutorMarks  TutorMark[]
  timeSlots   TimeSlot[]
  hourLimit   TutorHourLimit?
  allocations Allocation[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Course {
  id          Int          @id @default(autoincrement())
  code        String       @unique
  name        String
  tutorMarks  TutorMark[]
  allocations Allocation[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model TutorMark {
  id       Int     @id @default(autoincrement())
  tutorId  Int
  courseId Int
  mark     Decimal @db.Decimal(5, 2)
  tutor    Profile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  course   Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([tutorId, courseId])
}

model TimeSlot {
  id       Int          @id @default(autoincrement())
  tutorId  Int
  type     TimeSlotType
  startsAt DateTime
  endsAt   DateTime
  tutor    Profile      @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@index([tutorId, startsAt, endsAt])
}

model TutorHourLimit {
  id          Int     @id @default(autoincrement())
  tutorId     Int     @unique
  weeklyHours Decimal @db.Decimal(5, 2)
  tutor       Profile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
}

model Allocation {
  id             Int              @id @default(autoincrement())
  tutorId        Int
  courseId       Int
  startsAt       DateTime
  endsAt         DateTime
  allocatedHours Decimal          @db.Decimal(5, 2)
  status         AllocationStatus @default(PROPOSED)
  tutor          Profile          @relation(fields: [tutorId], references: [id], onDelete: Restrict)
  course         Course           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([tutorId, startsAt, endsAt])
  @@index([courseId])
}
