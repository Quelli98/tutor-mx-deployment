generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ORGANISER
  TUTOR
  STUDENT
}

enum OrganiserApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TimeSlotType {
  AVAILABLE
  BUSY
}

enum AllocationStatus {
  PROPOSED
  CONFIRMED
  CANCELLED
}

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  RETURNED
}

/// RETURN rows record an organiser sending a timesheet back; CORRECTION rows
/// record the tutor amending a work log while the sheet is still editable.
enum TimesheetRevisionKind {
  RETURN
  CORRECTION
}

enum TimesheetDisputeStatus {
  OPEN
  RESOLVED
}

enum SickOccurrenceStatus {
  EXCUSED
  SKIPPED
}

enum AbsenceReason {
  SICK
}

enum ExcuseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OverflowWorkStatus {
  OPEN
  FILLED
  CLOSED
  CANCELLED
}

enum VolunteerClaimStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum NotificationType {
  ALLOCATION_CREATED
  ALLOCATION_CHANGED
  TIMESHEET_SUBMITTED
  TIMESHEET_RETURNED
  TIMESHEET_APPROVED
  EXCUSE_SUBMITTED
  EXCUSE_DECIDED
  VOLUNTEER_OUTCOME
  TIMESHEET_REVIEW_DUE
  TIMESHEET_RESUBMIT_DUE
  VOLUNTEER_CLAIM_DUE
  EXCUSE_REVIEW_DUE
  // Appended by the timesheet correction work so the stored enum order matches
  // the order PostgreSQL actually holds after ALTER TYPE ... ADD VALUE.
  TIMESHEET_DISPUTED
  TIMESHEET_DISPUTE_RESOLVED
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  SWAP_REQUESTED
  SWAP_UPDATED
  STUDENT_SICK_SUBMITTED
  STUDENT_SICK_DECIDED
  BOOKING_ATTENDANCE_CHANGED
}

enum StaffingRequirementStatus {
  OPEN
  CLOSED
  CANCELLED
}

model Profile {
  auditEvents AuditEvent[]
  mutationReceipts MutationReceipt[]
  reviewedStudentSickNotes StudentSickNote[]
  scheduleRevision Int @default(0)
  studentBookings TutoringBooking[] @relation("StudentBookings")
  tutorBookings TutoringBooking[] @relation("TutorBookings")
  requestedSwaps TutorSwap[] @relation("SwapRequester")
  replacementSwaps TutorSwap[] @relation("SwapReplacement")
  bookingEvents BookingEvent[]
  swapEvents SwapEvent[]
  createdScenarios Scenario[] @relation("ScenarioCreator")
  editedScenarios Scenario[] @relation("ScenarioEditor")
  scenarioItems ScenarioItem[]
  scenarioPresence ScenarioPresence[]
  apiWriteReceipts ApiWriteReceipt[]
  id                  Int              @id @default(autoincrement())
  auth0Id             String           @unique
  email               String           @unique
  fullName            String
  role                UserRole
  tutorMarks          TutorMark[]
  timeSlots           TimeSlot[]
  hourLimit           TutorHourLimit?
  allocations         Allocation[]
  reviewedAllocations Allocation[]     @relation("AllocationReviewer")
  workLogs            WorkLog[]
  timesheets          Timesheet[]      @relation("TutorTimesheets")
  reviewedTimesheets  Timesheet[]      @relation("TimesheetReviewer")
  excuses             Excuse[]
  reviewedExcuses     Excuse[] @relation("ExcuseReviewer")
  volunteerClaims     VolunteerClaim[]
  notifications       Notification[]
  staffingRequirements StaffingRequirement[]
  timesheetRevisions  TimesheetRevision[] @relation("TimesheetRevisionAuthor")
  raisedDisputes      TimesheetDispute[]  @relation("TimesheetDisputeRaisedBy")
  resolvedDisputes    TimesheetDispute[]  @relation("TimesheetDisputeResolvedBy")
  reviewedOrganiserApplications OrganiserApplication[] @relation("OrganiserApplicationReviewer")
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
}

/// A lecturer registration request for organiser access. Pending applicants do
/// not receive a Tutor MX Profile or Auth0 ORGANISER role until a Master
/// Organiser approves the request.
model OrganiserApplication {
  id                 Int                        @id @default(autoincrement())
  auth0Id            String                     @unique
  email              String                     @unique
  fullName           String
  motivation         String?                    @db.VarChar(1000)
  status             OrganiserApplicationStatus @default(PENDING)
  reviewReason       String?                    @db.VarChar(500)
  reviewedAt         DateTime?
  reviewerProfileId  Int?
  reviewer           Profile?                   @relation("OrganiserApplicationReviewer", fields: [reviewerProfileId], references: [id], onDelete: SetNull)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  @@index([status, createdAt])
  @@index([reviewerProfileId])
}

model Notification {
  id                 Int              @id @default(autoincrement())
  recipientProfileId Int
  type               NotificationType
  title              String
  body               String
  linkPath           String
  targetType         String           @db.VarChar(64)
  targetId           Int?
  eventKey           String           @unique
  readAt             DateTime?
  createdAt          DateTime         @default(now())
  recipient          Profile          @relation(fields: [recipientProfileId], references: [id], onDelete: Cascade)

  @@index([recipientProfileId, readAt, createdAt])
}

model Course {
  tutoringBookings TutoringBooking[]
  scenarioItems ScenarioItem[]
  id           Int            @id @default(autoincrement())
  code         String         @unique
  name         String
  /** What one tutor-hour on this course costs. Every tutor is paid the same. */
  hourlyRate   Decimal?       @db.Decimal(8, 2)
  budget       Decimal?       @db.Decimal(12, 2)
  tutorMarks   TutorMark[]
  allocations  Allocation[]
  overflowWork OverflowWork[]
  staffingRequirements StaffingRequirement[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model TutorMark {
  id       Int     @id @default(autoincrement())
  tutorId  Int
  courseId Int
  mark     Decimal @db.Decimal(5, 2)
  tutor    Profile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  course   Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([tutorId, courseId])
  @@index([courseId, mark])
}

/// An academic teaching period. It bounds how far a recurring schedule entry
/// may repeat, so an imported timetable always stops at the end of the term it
/// was imported against. Terms belong to the institution, not to a profile, so
/// there is no owner column. Dates are stored as DATE (not timestamps) because
/// a term boundary is a calendar day, not an instant, and must not shift with
/// the reader's timezone.
model AcademicTerm {
  tutoringBookings TutoringBooking[]
  id             Int      @id @default(autoincrement())
  name           String   @unique @db.VarChar(120)
  startsOn       DateTime @db.Date
  endsOn         DateTime @db.Date
  year           Int?
  termNumber     Int?
  published      Boolean  @default(false)
  teachingBreaks Json     @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  timeSlots      TimeSlot[]

  @@unique([year, termNumber])
}

model TimeSlot {
  id               Int          @id @default(autoincrement())
  ownerId          Int          @map("tutorId")
  type             TimeSlotType
  startsAt         DateTime
  endsAt           DateTime
  recurrence       String?      @db.VarChar(32)
  label            String?      @db.VarChar(255)
  recurrenceUntil  DateTime?
  category         String       @default("UNAVAILABLE") @db.VarChar(32)
  seriesId         String?      @db.VarChar(36)
  termId           Int?
  dedupeKey        String? @unique @db.VarChar(64)
  owner            Profile      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  term             AcademicTerm? @relation(fields: [termId], references: [id], onDelete: SetNull)
  exceptions       OccurrenceException[]

  @@index([ownerId, type, startsAt, endsAt], map: "TimeSlot_tutorId_type_startsAt_endsAt_idx")
  @@index([ownerId, category, startsAt], map: "TimeSlot_category_idx")
  @@index([seriesId])
}

/// Per-occurrence override for a recurring time slot: cancel one date or move it
/// to a different time. The parent slot's recurrence is never inferred from its
/// label; exceptions are the only way to alter individual occurrences.
model OccurrenceException {
  id             Int      @id @default(autoincrement())
  timeSlotId     Int
  occurrenceDate DateTime @db.Date
  exceptionType  String   @default("CANCELLED") @db.VarChar(16)
  newStartsAt    DateTime?
  newEndsAt      DateTime?
  createdAt      DateTime @default(now())
  timeSlot       TimeSlot @relation(fields: [timeSlotId], references: [id], onDelete: Cascade)

  @@index([timeSlotId, occurrenceDate])
}

model TutorHourLimit {
  id          Int     @id @default(autoincrement())
  tutorId     Int     @unique
  weeklyHours Decimal @db.Decimal(5, 2)
  tutor       Profile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
}

model Allocation {
  minimumMark Float @default(50)
  version Int @default(1)
  swapRequests TutorSwap[] @relation("SwapSource")
  completedSwaps TutorSwap[] @relation("SwapResult")
  id             Int              @id @default(autoincrement())
  tutorId        Int
  courseId       Int
  startsAt       DateTime
  endsAt         DateTime
  allocatedHours Decimal          @db.Decimal(5, 2)
  status         AllocationStatus @default(PROPOSED)
  tutor          Profile          @relation(fields: [tutorId], references: [id], onDelete: Restrict)
  course         Course           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  reviewedBy     Profile?         @relation("AllocationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedById   Int?
  reviewedAt     DateTime?
  /** Why an organiser chose a tutor other than the one bulk allocation proposed. */
  overrideReason String?
  workLogs       WorkLog[]
  excuses        Excuse[]
  overflowWork   OverflowWork?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([id, tutorId])
  @@index([reviewedById])
  @@index([tutorId, status, startsAt, endsAt])
  @@index([courseId, status, startsAt])
}

model Timesheet {
  id           Int             @id @default(autoincrement())
  tutorId      Int
  weekStart    DateTime        @db.Date
  status       TimesheetStatus @default(DRAFT)
  submittedAt  DateTime?
  reviewedAt   DateTime?
  reviewedById Int?
  reviewReason String?
  tutor        Profile         @relation("TutorTimesheets", fields: [tutorId], references: [id], onDelete: Restrict)
  reviewedBy   Profile?        @relation("TimesheetReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  workLogs     WorkLog[]
  revisions    TimesheetRevision[]
  declarations TimesheetDeclaration[]
  disputes     TimesheetDispute[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([tutorId, weekStart])
  @@unique([id, tutorId])
  @@index([status, submittedAt])
  @@index([tutorId, status, weekStart])
}

/// Append-only history of a timesheet's evidence. A correction never overwrites
/// the work log it replaces: the prior hours and description are kept here
/// beside the new ones, together with the reason that prompted the change.
model TimesheetRevision {
  id                  Int                   @id @default(autoincrement())
  timesheetId         Int
  tutorId             Int
  kind                TimesheetRevisionKind
  workLogId           Int?
  /// Nullable for the same reason as Timesheet.reviewedById: deleting the account
  /// that wrote a line of history clears who wrote it and keeps the history.
  authorProfileId     Int?
  reason              String?
  previousHours       Decimal?              @db.Decimal(5, 2)
  previousDescription String?
  newHours            Decimal?              @db.Decimal(5, 2)
  newDescription      String?
  timesheet           Timesheet             @relation(fields: [timesheetId, tutorId], references: [id, tutorId], onDelete: Restrict)
  workLog             WorkLog?              @relation(fields: [workLogId], references: [id], onDelete: Restrict)
  author              Profile?              @relation("TimesheetRevisionAuthor", fields: [authorProfileId], references: [id], onDelete: Restrict)
  createdAt           DateTime              @default(now())

  @@index([timesheetId, createdAt])
}

/// The tutor's explicit acknowledgement of the submission statement, stored per
/// resubmission. Resubmitting a returned timesheet requires one recorded after
/// both the return and the last correction, so the declaration always covers the
/// figures actually being sent.
model TimesheetDeclaration {
  id               Int       @id @default(autoincrement())
  timesheetId      Int
  tutorId          Int
  statementVersion String    @db.VarChar(32)
  timesheet        Timesheet @relation(fields: [timesheetId, tutorId], references: [id, tutorId], onDelete: Restrict)
  declaredAt       DateTime  @default(now())

  @@index([timesheetId, declaredAt])
}

/// A tutor's formal objection to a timesheet decision. An open dispute is a
/// payroll hold: the affected work must not be paid while it stands.
model TimesheetDispute {
  id                  Int                    @id @default(autoincrement())
  timesheetId         Int
  tutorId             Int
  reason              String
  status              TimesheetDisputeStatus @default(OPEN)
  raisedByProfileId   Int
  resolvedByProfileId Int?
  resolutionReason    String?
  resolvedAt          DateTime?
  timesheet           Timesheet              @relation(fields: [timesheetId, tutorId], references: [id, tutorId], onDelete: Restrict)
  raisedBy            Profile                @relation("TimesheetDisputeRaisedBy", fields: [raisedByProfileId], references: [id], onDelete: Restrict)
  resolvedBy          Profile?               @relation("TimesheetDisputeResolvedBy", fields: [resolvedByProfileId], references: [id], onDelete: Restrict)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([timesheetId, status])
  @@index([status, createdAt])
}

model WorkLog {
  id                 Int        @id @default(autoincrement())
  tutorId            Int
  allocationId       Int
  timesheetId        Int?
  workDate           DateTime   @db.Date
  hours              Decimal    @db.Decimal(5, 2)
  description        String
  /// Snapshot of the course hourly rate at the moment the timesheet was approved.
  /// Null until approval; once set it never changes, so historical spend stays
  /// reproducible even if the course rate is later adjusted.
  approvedHourlyRate Decimal?   @db.Decimal(8, 2)
  tutor              Profile    @relation(fields: [tutorId], references: [id], onDelete: Restrict)
  allocation         Allocation @relation(fields: [allocationId, tutorId], references: [id, tutorId], onDelete: Restrict)
  timesheet          Timesheet? @relation(fields: [timesheetId, tutorId], references: [id, tutorId], onDelete: Restrict)
  revisions          TimesheetRevision[]
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@unique([tutorId, allocationId, workDate])
  @@index([tutorId, workDate])
  @@index([timesheetId])
}

model Excuse {
  id           Int           @id @default(autoincrement())
  tutorId      Int
  allocationId Int
  reason       String
  status       ExcuseStatus  @default(PENDING)
  reviewReason String?
  // Allocation is already one concrete occurrence. This request also stores its
  // attendance exception, without removing or cancelling the allocation.
  occurrenceStatus SickOccurrenceStatus?
  absenceReason AbsenceReason @default(SICK)
  reviewedAt DateTime?
  reviewedById Int?
  reviewedBy Profile? @relation("ExcuseReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  tutor        Profile       @relation(fields: [tutorId], references: [id], onDelete: Restrict)
  allocation   Allocation    @relation(fields: [allocationId, tutorId], references: [id, tutorId], onDelete: Restrict)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([tutorId, allocationId])
  @@index([status, createdAt])
  @@index([tutorId, status])
}

model OverflowWork {
  id                  Int                   @id @default(autoincrement())
  courseId            Int
  sourceAllocationId  Int?                  @unique
  sourceRequirementId Int?
  slotIndex           Int?
  startsAt            DateTime
  endsAt              DateTime
  hours               Decimal               @db.Decimal(5, 2)
  status              OverflowWorkStatus    @default(OPEN)
  closesAt            DateTime?
  course              Course                @relation(fields: [courseId], references: [id], onDelete: Restrict)
  sourceAllocation    Allocation?           @relation(fields: [sourceAllocationId], references: [id], onDelete: Restrict)
  sourceRequirement   StaffingRequirement?  @relation(fields: [sourceRequirementId], references: [id], onDelete: Restrict)
  volunteerClaims     VolunteerClaim[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@unique([sourceRequirementId, slotIndex])
  @@index([status, startsAt, closesAt])
  @@index([courseId, status, startsAt])
  @@index([sourceRequirementId, status])
}

model VolunteerClaim {
  id             Int                  @id @default(autoincrement())
  overflowWorkId Int
  studentId      Int
  status         VolunteerClaimStatus @default(PENDING)
  reviewReason   String?
  overflowWork   OverflowWork         @relation(fields: [overflowWorkId], references: [id], onDelete: Restrict)
  student        Profile              @relation(fields: [studentId], references: [id], onDelete: Restrict)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([overflowWorkId, studentId])
  @@index([overflowWorkId, status])
  @@index([studentId, status, createdAt])
}

model StaffingRequirement {
  id            Int                       @id @default(autoincrement())
  courseId      Int
  startsAt      DateTime
  endsAt        DateTime
  tutorsNeeded  Int
  status        StaffingRequirementStatus @default(OPEN)
  notes         String?
  createdById   Int?
  course        Course                    @relation(fields: [courseId], references: [id], onDelete: Restrict)
  createdBy     Profile?                  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  overflowWork  OverflowWork[]
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@index([courseId, status, startsAt])
  @@index([createdById])
}

// Internal retry receipts; no public read endpoint.
model ApiWriteReceipt {
  profileId   Int
  key         String   @db.VarChar(128)
  fingerprint String   @db.Char(64)
  result      Json?
  createdAt   DateTime @default(now()) @db.Timestamp(3)
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@id([profileId, key])
}

/// A bounded, versioned planning context. Publishing is handled transactionally.
model Scenario {
  id Int @id @default(autoincrement())
  name String @db.VarChar(120)
  notes String @default("") @db.VarChar(2000)
  startsAt DateTime
  endsAt DateTime
  status String @default("DRAFT") @db.VarChar(16)
  version Int @default(1)
  baseLiveRevision String @db.VarChar(64)
  createdById Int?
  updatedById Int?
  createdBy Profile? @relation("ScenarioCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy Profile? @relation("ScenarioEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
  items ScenarioItem[]
  presence ScenarioPresence[]
  @@index([status, updatedAt])
}

model ScenarioItem {
  id Int @id @default(autoincrement())
  scenarioId Int
  sourceAllocationId Int?
  tutorId Int
  courseId Int
  startsAt DateTime
  endsAt DateTime
  allocatedHours Decimal @db.Decimal(5,2)
  minimumMark Decimal @default(50) @db.Decimal(5,2)
  locked Boolean @default(false)
  scenario Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  tutor Profile @relation(fields: [tutorId], references: [id], onDelete: Restrict)
  course Course @relation(fields: [courseId], references: [id], onDelete: Restrict)
  @@unique([scenarioId, sourceAllocationId])
  @@index([scenarioId])
}

/// Presence is a TTL activity hint, never an authorization or editing lock.
model ScenarioPresence {
  scenarioId Int
  profileId Int
  lastSeenAt DateTime @default(now())
  scenario Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  @@id([scenarioId, profileId])
  @@index([lastSeenAt])
}

model TutoringBooking {
 sickNotes StudentSickNote[]
 id Int @id @default(autoincrement())
 studentId Int
 tutorId Int
 courseId Int
 termId Int
 startsAt DateTime
 endsAt DateTime
 status String @default("CONFIRMED") @db.VarChar(16)
 occurrenceStatus String @default("SCHEDULED") @db.VarChar(16)
 version Int @default(1)
 requestKey String @db.VarChar(128)
 requestHash String @db.VarChar(64)
 createdAt DateTime @default(now())
 updatedAt DateTime @default(now())
 student Profile @relation("StudentBookings",fields:[studentId],references:[id],onDelete:Restrict)
 tutor Profile @relation("TutorBookings",fields:[tutorId],references:[id],onDelete:Restrict)
 course Course @relation(fields:[courseId],references:[id],onDelete:Restrict)
 term AcademicTerm @relation(fields:[termId],references:[id],onDelete:Restrict)
 events BookingEvent[]
 @@unique([studentId,requestKey])
 @@index([tutorId,status,startsAt])
 @@index([studentId,status,startsAt])
}
model TutorSwap {
 id Int @id @default(autoincrement())
 allocationId Int
 requesterId Int
 replacementId Int
 replacementAllocationId Int?
 allocationRevision String @db.VarChar(64)
 snapshot Json
 reason String @db.VarChar(1000)
 status String @default("REQUESTED") @db.VarChar(16)
 version Int @default(1)
 createdAt DateTime @default(now())
 updatedAt DateTime @default(now())
 allocation Allocation @relation("SwapSource",fields:[allocationId],references:[id],onDelete:Restrict)
 replacementAllocation Allocation? @relation("SwapResult",fields:[replacementAllocationId],references:[id],onDelete:Restrict)
 requester Profile @relation("SwapRequester",fields:[requesterId],references:[id],onDelete:Restrict)
 replacement Profile @relation("SwapReplacement",fields:[replacementId],references:[id],onDelete:Restrict)
 events SwapEvent[]
 @@index([status,createdAt])
}
model BookingEvent {
 id Int @id @default(autoincrement())
 bookingId Int
 actorId Int
 action String @db.VarChar(24)
 version Int
 note String @default("") @db.VarChar(1000)
 createdAt DateTime @default(now())
 booking TutoringBooking @relation(fields:[bookingId],references:[id],onDelete:Restrict)
 actor Profile @relation(fields:[actorId],references:[id],onDelete:Restrict)
 @@unique([bookingId,version])
}
model SwapEvent {
 id Int @id @default(autoincrement())
 swapId Int
 actorId Int
 action String @db.VarChar(24)
 version Int
 note String @default("") @db.VarChar(1000)
 createdAt DateTime @default(now())
 swap TutorSwap @relation(fields:[swapId],references:[id],onDelete:Restrict)
 actor Profile @relation(fields:[actorId],references:[id],onDelete:Restrict)
 @@unique([swapId,version])
}

model StudentSickNote {
 id Int @id @default(autoincrement())
 bookingId Int
 reason String @db.VarChar(1000)
 status String @default("PENDING") @db.VarChar(16)
 version Int @default(1)
 reviewNote String @default("") @db.VarChar(1000)
 reviewedById Int?
 reviewedAt DateTime?
 createdAt DateTime @default(now())
 booking TutoringBooking @relation(fields:[bookingId],references:[id],onDelete:Restrict)
 reviewedBy Profile? @relation(fields:[reviewedById],references:[id],onDelete:Restrict)
 @@index([status,id])
}

model AuditEvent {
 id Int @id @default(autoincrement())
 actorId Int
 action String @db.VarChar(64)
 targetType String @db.VarChar(24)
 targetId Int
 before Json @default("{}")
 after Json @default("{}")
 reason String @default("") @db.VarChar(1000)
 createdAt DateTime @default(now())
 actor Profile @relation(fields:[actorId],references:[id],onDelete:Restrict)
 @@index([createdAt,id])
 @@index([targetType,targetId,id])
 @@index([actorId,createdAt])
}
model MutationReceipt {
 id Int @id @default(autoincrement())
 actorId Int
 scope String @db.VarChar(100)
 requestKey String @db.VarChar(128)
 requestHash String @db.VarChar(64)
 resultId Int
 createdAt DateTime @default(now())
 actor Profile @relation(fields:[actorId],references:[id],onDelete:Restrict)
 @@unique([actorId,scope,requestKey])
}
